-- =============================================
-- 👻 HIDE & DISABLE EVERYTHING EXCEPT LOBBY
-- =============================================
local function hideAllExceptLobby()
    local pg = player:FindFirstChild("PlayerGui")
    if not pg then return end
    for _, child in ipairs(pg:GetChildren()) do
        if child.Name ~= "Lobby" then
            pcall(function()
                -- Hide from view
                if child:IsA("GuiObject") or child:IsA("ScreenGui") then
                    child.Visible = false
                end
                -- Disable interactivity / updates
                if child:IsA("ScreenGui") then
                    child.Enabled = false
                end
                if child:IsA("GuiObject") then
                    child.Active = false
                    child.Selectable = false
                end
                -- If it's a Frame or any other container, we also go through its descendants
                -- to ensure every interactive element is disabled (though parent's Visible false already hides them)
                for _, desc in ipairs(child:GetDescendants()) do
                    if desc:IsA("GuiObject") then
                        desc.Active = false
                        desc.Selectable = false
                    end
                    if desc:IsA("ScreenGui") then
                        desc.Enabled = false
                    end
                end
            end)
            print("[HIDE] Hidden & disabled: " .. child.Name)
        end
    end
    -- Also remove the blur effect (optional)
    pcall(function()
        local blur = game:GetService("Lighting"):FindFirstChild("FrameOpenBlur")
        if blur then blur:Destroy() end
    end)
end
