local function getDenyButton(frame)
    if not frame or not frame.Parent then return nil end
    local pkg = frame:FindFirstChild("Package")
    if not pkg then return nil end
    local options = pkg:FindFirstChild("Options")
    if not options then return nil end
    local denyBtn = options:FindFirstChild("Deny")
    if denyBtn and denyBtn:IsA("TextButton") and denyBtn.Name == "Deny" and denyBtn.Parent then
        return denyBtn
    end
    return nil
end

local function getConfirmButton()
    local alerts = postOfficeMenus:FindFirstChild("Alerts")
    if not alerts or not alerts.Visible then return nil end
    local confirmReject = alerts:FindFirstChild("ConfirmReject")
    if not confirmReject or not confirmReject.Visible then return nil end
    local options = confirmReject:FindFirstChild("Options")
    if not options then return nil end
    local confirmBtn = options:FindFirstChild("Confirm")
    if confirmBtn and confirmBtn:IsA("TextButton") and confirmBtn.Name == "Confirm" and confirmBtn.Parent then
        return confirmBtn
    end
    return nil
end

local function vimClickStrict(button, expectedName)
    if not button or not button.Parent then return false end
    if button.Name ~= expectedName then
        print("[VIM] ❌ Wrong button! Expected '"..expectedName.."' got '"..button.Name.."'")
        return false
    end
    local container = button.Parent
    pcall(function()
        for _, sibling in ipairs(container:GetChildren()) do
            if sibling ~= button and sibling:IsA("TextButton") then
                sibling.Selectable = false
                sibling.Active = false
            end
        end
    end)
    pcall(function() GuiService.SelectedObject = nil end)
    task.wait(0.05)
    pcall(function()
        button.Selectable = true
        button.Active = true
    end)
    pcall(function() GuiService.SelectedObject = button end)
    task.wait(0.15)
    if GuiService.SelectedObject ~= button then
        print("[VIM] ❌ Selection failed on '"..expectedName.."'")
        pcall(function() GuiService.SelectedObject = nil end)
        return false
    end
    print("[VIM] ✅ Verified '"..expectedName.."' – pressing Enter")
    sendKey(Enum.KeyCode.Return, true)
    task.wait(0.1)
    sendKey(Enum.KeyCode.Return, false)
    sendKey(Enum.KeyCode.ButtonA, true)
    task.wait(0.1)
    sendKey(Enum.KeyCode.ButtonA, false)
    task.wait(0.1)
    pcall(function() GuiService.SelectedObject = nil end)
    return true
end

-- =============================================
-- ⚡ REJECTION (DIRECT, NO QUEUE)
-- =============================================
local lastRejectTime = 0
local REJECT_COOLDOWN = 2.0

local function rejectFrame(frame)
    if not frame or not frame.Parent then return false end
    local now = tick()
    if now - lastRejectTime < REJECT_COOLDOWN then
        return false
    end

    currentAction = "Rejecting: "..frame.Name
    local denyBtn = getDenyButton(frame)
    if not denyBtn then
        return false
    end

    if not vimClickStrict(denyBtn, "Deny") then
        return false
    end

    local confirmBtn = nil
    for i = 1, 50 do
        confirmBtn = getConfirmButton()
        if confirmBtn then break end
        task.wait(0.1)
    end
    if not confirmBtn then
        denyBtn = getDenyButton(frame)
        if denyBtn then
            vimClickStrict(denyBtn, "Deny")
            for i = 1, 30 do
                confirmBtn = getConfirmButton()
                if confirmBtn then break end
                task.wait(0.1)
            end
        end
    end

    if confirmBtn then
        task.wait(0.3)
        if not vimClickStrict(confirmBtn, "Confirm") then
            return false
        end
        for i = 1, 50 do
            local alerts = postOfficeMenus:FindFirstChild("Alerts")
            if not alerts or not alerts.Visible then break end
            task.wait(0.1)
        end
    else
        return false
    end

    local start = tick()
    while frame.Parent and tick() - start < 8 do
        task.wait(0.2)
    end
    local success = not frame.Parent
    if success then
        lastRejectTime = tick()
        currentAction = "Rejected: "..frame.Name
    end
    return success
end

