local function getFrames()
    local out = {}
    for name, f in pairs(frameCache) do
        if f and f.Parent then
            table.insert(out, f)
        end
    end
    return out
end

scrollingFrame.ChildAdded:Connect(function(c)
    if c:IsA("Frame") then
        frameCache[c.Name] = c
        frameCount = frameCount + 1
    end
end)

scrollingFrame.ChildRemoved:Connect(function(c)
    if c:IsA("Frame") and frameCache[c.Name] then
        frameCache[c.Name] = nil
        frameCount = math.max(0, frameCount - 1)
    end
end)

-- =============================================
-- 📝 TEXT HELPERS
-- =============================================
local function getFrameSender(frame)
    if not frame or not frame.Parent then return "unknown" end
    local pkg = frame:FindFirstChild("Package")
    if not pkg then return "unknown" end
    local from = pkg:FindFirstChild("From")
    if from and from:IsA("TextLabel") then
        local txt = (from.Text or ""):gsub("@",""):lower()
        if txt ~= "" then return txt end
    end
    return "unknown"
end

local function getFrameMessage(frame)
    if not frame or not frame.Parent then return "" end
    local pkg = frame:FindFirstChild("Package")
    if not pkg then return "" end
    local msg = pkg:FindFirstChild("Message")
    if msg and msg:IsA("TextLabel") then return msg.Text or "" end
    return ""
end

local function stripInvisible(str)
    if not str then return "" end
    local filtered = {}
    for i = 1, #str do
        local b = str:byte(i)
        if b >= 32 and b <= 126 then
            table.insert(filtered, str:sub(i,i))
        end
    end
    return table.concat(filtered)
end

local function hasAlnum(str)
    if not str then return false end
    return str:match("%w") ~= nil
end

local function isCorrupted(frame)
    local sender = stripInvisible(getFrameSender(frame)):lower()
    local message = stripInvisible(getFrameMessage(frame))
    return sender == "unknown" and not hasAlnum(message)
end

-- =============================================
-- ⚡ FAIL PROCESSOR (DIRECT, NO QUEUE)
-- =============================================
local currentState = "COLLECT"  -- we'll sync this from main loop

local function processFails()
    if KILL then return end

    -- 1. Corrupted packages: reject only if NOT in TIMER state
    if currentState ~= "TIMER" then
        for _, frame in ipairs(getFrames()) do
            if frame:IsA("Frame") and isCorrupted(frame) then
                print("[CORRUPT] Rejecting corrupted package: "..frame.Name)
                rejectFrame(frame)
                return
            end
        end
    end

    -- 2. Server‑sent fails (always processed)
    if #FAILS == 0 then return end
    local unresolved = {}
    for _, user in ipairs(FAILS) do
        local name = user:gsub("@",""):lower()
        if name ~= "" and not blockedUsers[name] then
            unresolved[name] = true
        end
    end
    if next(unresolved) == nil then return end

    for _, frame in ipairs(getFrames()) do
        if not frame:IsA("Frame") then continue end
        local sender = stripInvisible(getFrameSender(frame)):lower()
        local message = stripInvisible(getFrameMessage(frame))
        if sender == "unknown" then
            for badUser in pairs(unresolved) do
                if message:find(badUser, 1, true) then
                    print("[FAIL] Found fail '"..badUser.."' in message, rejecting and blacklisting")
                    if rejectFrame(frame) then
                        blockedUsers[badUser] = true
                    end
                    return
                end
            end
        else
            if unresolved[sender] then
                print("[FAIL] Sender '"..sender.."' is in fails, rejecting and blacklisting")
                if rejectFrame(frame) then
                    blockedUsers[sender] = true
                end
                return
            end
            for badUser in pairs(unresolved) do
                if sender:find(badUser, 1, true) then
                    print("[FAIL] Sender '"..sender.."' contains fail '"..badUser.."', rejecting and blacklisting")
                    if rejectFrame(frame) then
                        blockedUsers[badUser] = true
                    end
                    return
                end
            end
        end
    end
end

