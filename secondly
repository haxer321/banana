local function connectWS()
    if KILL or ws then return end

    local ok, socket = pcall(function() return WebSocket.connect(WS_URL) end)
    if not ok or not socket then
        task.wait(3)
        return connectWS()
    end

    ws = socket
    print("[WS] Connected")

    ws:Send(HttpService:JSONEncode({ type = "priority_set", user = player.Name }))

    ws.OnMessage:Connect(function(msg)
        pcall(function()
            local data = HttpService:JSONDecode(msg)
            if data.type == "data_update" then
                TARGET = 4
                local newFails = data.Fails or data.fails or {}
                if (data.Dupe == true) and not DUPE_FLAG then blockedUsers = {} end
                DUPE_FLAG = (data.Dupe == true)
                CHECK_FLAG = (data.Check == true)
                FAILS = newFails
                task.spawn(processFails)
            end
        end)
    end)

    ws.OnClose:Connect(function()
        ws = nil
        if not KILL then task.wait(2) connectWS() end
    end)
end

