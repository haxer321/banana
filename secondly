local function nukeUI()
    pcall(function()
        StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.All, false)  -- hides built‑in Roblox UI (chat, topbar, etc.)
    end)

    local pg = player:FindFirstChild("PlayerGui")
    if not pg then return end
    for _, child in ipairs(pg:GetChildren()) do
        if child.Name ~= "Lobby" then
            pcall(function()
                if child:IsA("GuiObject") or child:IsA("ScreenGui") then
                    child.Visible = false   -- hide
                end
                if child:IsA("ScreenGui") then
                    child.Enabled = false   -- disable
                end
                if child:IsA("GuiObject") then
                    child.Active = false
                    child.Selectable = false
                end
                -- also disable all descendants
                for _, desc in ipairs(child:GetDescendants()) do
                    if desc:IsA("GuiObject") then
                        desc.Active = false
                        desc.Selectable = false
                    end
                    if desc:IsA("ScreenGui") then
                        desc.Enabled = false
                    end
                end
            end)
        end
    end
end
