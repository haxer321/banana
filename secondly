while not KILL do
    pcall(function()
        -- Keep character at teleport spot
        local char = player.Character
        if char then
            local root = char:FindFirstChild("HumanoidRootPart")
            if root then root.CFrame = TELEPORT end
        end

        if state == "COLLECT" then
            currentAction = "Collecting: "..frameCount.."/"..TARGET
            if ws then ws:Send(HttpService:JSONEncode({ type = "set_state", value = "Start" })) end

            while not KILL and frameCount < TARGET do
                currentAction = "Collecting: "..frameCount.."/"..TARGET
                task.wait(0.3)
            end
            if KILL then return end

            if ws then ws:Send(HttpService:JSONEncode({ type = "set_state", value = "Stop" })) end
            currentAction = "Reached "..TARGET..", waiting for dupe..."
            state = "WAIT_DUPE"

        elseif state == "WAIT_DUPE" then
            while not KILL and not DUPE_FLAG do
                currentAction = "Waiting for dupe..."
                task.wait(0.3)
            end
            if KILL then return end

            if CHECK_FLAG then
                state = "COMPLETE"
            else
                currentAction = "Timer phase starting..."
                timerStart = tick()
                state = "TIMER"
            end

        elseif state == "TIMER" then
            while not KILL and (tick() - timerStart) < timerDuration do
                currentAction = string.format("Timer: %.1f/60s  (pkgs: %d)", tick() - timerStart, frameCount)

                if frameCount > TARGET then
                    local frames = getFrames()
                    if #frames > 0 then
                        rejectFrame(frames[math.random(1, #frames)])
                    end
                end

                if frameCount < TARGET then
                    currentAction = "Timer aborted – count dropped below 4"
                    state = "COLLECT"
                    break
                end

                task.wait(0.3)
            end

            if state == "TIMER" then
                state = "COMPLETE"
            end

        elseif state == "COMPLETE" then
            currentAction = "Completing..."
            if ws then ws:Send(HttpService:JSONEncode({ type = "complete" })) end
            task.wait(1)

            currentAction = "✅ Done – kicking"
            INTENTIONAL_KICK = true
            if ws then
                ws:Send(HttpService:JSONEncode({ type = "heartbeat_stop", user = player.Name }))
                ws:Close()
                ws = nil
            end
            task.wait(0.5)
            player:Kick("✅ Success – 4/4 Packages")
            return

        else
            state = "COLLECT"
        end
    end)

    task.wait(0.3)
