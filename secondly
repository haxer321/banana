local function rebuildCache()
    frameCache = {}
    frameCount = 0
    for _, v in ipairs(scrollingFrame:GetChildren()) do
        if v:IsA("Frame") then
            frameCache[v.Name] = v
            frameCount = frameCount + 1
        end
    end
end
