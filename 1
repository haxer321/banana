print("=========================================================")


local function sendWS(payload)

    print("[WS] sendWS called")

    if not ws then
        warn("[WS] ws is NIL")
        return false
    end

    if not wsConnected then
        warn("[WS] wsConnected is FALSE")
        return false
    end

    local success, err = pcall(function()

        local encoded = HttpService:JSONEncode(payload)

        print("[WS] Sending:", encoded)

        ws:Send(encoded)

    end)

    if not success then
        warn("[WS] Send ERROR:", err)
        return false
    end

    print("[WS] Send successful")

    return true
end


local function connectWebSocket()

    print("=========================================================")
    print("[WS] CONNECT FUNCTION CALLED")
    print("[WS] URL:", WS_URL)
    print("=========================================================")

    if not websocket then
        warn("[WS] WebSocket library is NIL")
        return
    end

    print("[WS] Calling websocket.connect()...")

    local success, result = pcall(function()
        return websocket.connect(WS_URL)
    end)

    print("[WS] Connect pcall success:", success)
    print("[WS] Connect result:", tostring(result))

    if success and result then

        ws = result
        wsConnected = true

        print("[WS] CONNECTED")
        print("[WS] wsConnected:", wsConnected)

        sendWS({
            type = "client_ready"
        })

        print("[WS] Installing OnMessage listener...")

        local messageSuccess, messageError = pcall(function()

            ws.OnMessage:Connect(function(msg)

                print("---------------------------------------------------------")
                print("[WS] MESSAGE RECEIVED")
                print("[WS] Raw message:", tostring(msg))

                local ok, data = pcall(function()
                    return HttpService:JSONDecode(msg)
                end)

                if not ok then
                    warn("[WS] JSON decode failed")
                    warn("[WS] Error:", data)
                    return
                end

                if not data then
                    warn("[WS] Decoded data is NIL")
                    return
                end

                print("[WS] Message type:", tostring(data.type))

                if data.type == "state" and data.state then

                    local state = data.state

                    local dupe = state.Dupe
                    local check = state.Check
                    local busy = state.Busy

                    print("[WS] STATE")
                    print("[WS]   Dupe:", tostring(dupe))
                    print("[WS]   Check:", tostring(check))
                    print("[WS]   Busy:", tostring(busy))
                    print("[WS]   hasLeft:", tostring(hasLeft))
                    print("[WS]   readyToRejoin:", tostring(readyToRejoin))

                    if hasLeft and not readyToRejoin then

                        if check == true and busy == false then

                            print("[WS] REJOIN CONDITION MET")

                            readyToRejoin = true

                            print(
                                "[WS] readyToRejoin =",
                                tostring(readyToRejoin)
                            )

                            if watchdogConnection then
                                print("[WS] Disconnecting watchdog...")
                                watchdogConnection:Disconnect()
                                watchdogConnection = nil
                            end

                        end

                    end

                elseif data.type == "event" then

                    print("[WS] EVENT:", tostring(data.event))

                else

                    print("[WS] Unknown message type")

                end

                print("---------------------------------------------------------")

            end)

        end)

        if messageSuccess then
            print("[WS] OnMessage listener installed")
        else
            warn("[WS] OnMessage ERROR:", messageError)
        end


        print("[WS] Installing OnClose listener...")

        local closeSuccess, closeError = pcall(function()

            ws.OnClose:Connect(function()

                print("[WS] CONNECTION CLOSED")

                wsConnected = false
                ws = nil

                print("[WS] wsConnected = false")
                print("[WS] Waiting 5 seconds before reconnect...")

                task.wait(5)

                print("[WS] Reconnecting...")

                task.spawn(connectWebSocket)

            end)

        end)

        if closeSuccess then
            print("[WS] OnClose listener installed")
        else
            warn("[WS] OnClose ERROR:", closeError)
        end

    else

        warn("[WS] CONNECTION FAILED")
        warn("[WS] Error:", tostring(result))

    end

end


