-- ==================== WEBSOCKET CONNECTION (NON-BLOCKING) ====================
local WS_URL = "ws://192.168.1.67:8080"  -- CHANGE TO YOUR SERVER IP
local ws = nil
local wsConnected = false
local sentFail = false
local sentRecovered = false
local readyToRejoin = false
local watchdogConnection = nil

local function connectWebSocket()
    if not wsAvailable then
        print("[WS] WebSocket library unavailable (wsAvailable is false) – not connecting")
        return
    end
    if not websocket then
        print("[WS] Global 'websocket' is nil – cannot connect")
        return
    end
    print(string.format("[DEBUG] Attempting WebSocket connection to %s", WS_URL))
    local success, result = pcall(function()
        return websocket.connect(WS_URL)
    end)
    if success and result then
        ws = result
        wsConnected = true
        print("[WS] Connected to server")
        ws:Send(HttpService:JSONEncode({ type = "client_ready" }))
        ws.OnMessage:Connect(function(msg)
            local ok, data = pcall(function()
                return HttpService:JSONDecode(msg)
            end)
            if not ok or not data then return end
            if data.type == "state" and data.state then
                local state = data.state
                local dupe = state.Dupe
                local check = state.Check
                local busy = state.Busy
                print(string.format("[WS] State - Dupe: %s, Check: %s, Busy: %s",
                    tostring(dupe), tostring(check), tostring(busy)))
                if hasLeft and not readyToRejoin then
                    if check == true and busy == false then
                        print("[WS] Check=true & Busy=false! Ready to rejoin.")
                        readyToRejoin = true
                        if watchdogConnection then
                            watchdogConnection:Disconnect()
                            watchdogConnection = nil
                        end
                    end
                end
            elseif data.type == "event" then
                print(string.format("[WS] Event: %s", data.event))
            end
        end)
        ws.OnClose:Connect(function()
            wsConnected = false
            ws = nil
            print("[WS] Disconnected, reconnecting in 5s...")
            task.wait(5)
            connectWebSocket()
        end)
    else
        print("[WS] Failed to connect:", tostring(result))
        print("[WS] Retrying in 5s...")
        task.wait(5)
        connectWebSocket()
    end
end

