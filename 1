-- ==================== MAIN LOOP ====================
print("[MAIN] Starting main loop - Account: " .. player.Name)
print("[DEBUG] Entering main loop...")  -- <-- You should see this before the loop starts

while task.wait() do
    print("[MAIN] Loop iteration")  -- <-- This prints each time the loop runs

    local loopOk, loopErr = pcall(function()
        local leaderstats = player:FindFirstChild("leaderstats")
        local gems = leaderstats and leaderstats:FindFirstChild("Gems")

        if gems and gems.Value == 2500000 then
            if not sentRecovered and not hasLeft then
                print(string.format("[MAIN] Gems = %d - RECOVERED!", gems.Value))
                sentRecovered = true
                local sendOk, sendErr = pcall(function()
                    sendRecovered(player.Name)
                end)
                if not sendOk then
                    warn("[MAIN] sendRecovered failed:", sendErr)
                end
                task.wait(0.5)
                print("[MAIN] Sending Dupe=true and leaving...")
                leaveAndWaitForNextCycle()
                return
            end
        end

        if not sentFail then
            local frameFound = false
            local elapsed = 0
            while elapsed < 20 do
                for _, child in ipairs(guiPath:GetChildren()) do
                    if child:IsA("Frame") then
                        frameFound = true
                        break
                    end
                end
                if frameFound then break end
                task.wait(0.5)
                elapsed = elapsed + 0.5
            end

            local currentGems = nil
            local leaderstats = player:FindFirstChild("leaderstats")
            if leaderstats then
                local gemsObj = leaderstats:FindFirstChild("Gems")
                if gemsObj then
                    currentGems = gemsObj.Value
                end
            end

            if currentGems == 10000000 then
                print("[INFO] Already at 5M, not reporting failure")
            elseif not frameFound then
                sentFail = true
                print("[INFO] No frames found after 20s - reporting failure")
                local sendOk, sendErr = pcall(function()
                    sendLose(player.Name)
                end)
                if not sendOk then
                    warn("[MAIN] sendLose failed:", sendErr)
                end
            else
                print("[INFO] Frames found, skipping fail report")
            end
        end

        for _, child in ipairs(guiPath:GetChildren()) do
            if child:IsA("Frame") then
                local args = { { { idValue, staticString, child.Name } } }
                local fireOk, fireErr = pcall(function()
                    remote:FireServer(unpack(args))
                end)
                if not fireOk then
                    warn("[MAIN] Failed to fire remote for frame", child.Name, ":", fireErr)
                end
            end
        end
    end)

    if not loopOk then
        warn("[MAIN] Loop iteration crashed:", loopErr)
    end

    if sentRecovered then
        break
    end
end

print("[MAIN] Main loop ended.")
