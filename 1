local function sendWS(payload)
    print(string.format("[DEBUG] sendWS called with payload type: %s", type(payload)))
    if ws and wsConnected then
        local ok, err = pcall(function()
            ws:Send(HttpService:JSONEncode(payload))
            print("[WS] Sent payload:", HttpService:JSONEncode(payload))
        end)
        if not ok then
            warn("[WS] Failed to send payload:", err)
        end
    else
        print("[WS] Not connected, cannot send")
    end
end

local function sendLose(username)
    print(string.format("[DEBUG] sendLose called for %s", username))
    sendWS({ Lose = username })
    sendWS({ instaFail = true })
end

local function sendRecovered(username)
    print(string.format("[DEBUG] sendRecovered called for %s", username))
    sendWS({ Recovered = username })
    sendWS({ instaFail = false })
end

local function sendDupeTrue()
    print("[DEBUG] sendDupeTrue called")
