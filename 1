-- =========================================================
-- LEAVE / WAIT
-- =========================================================
local function leaveAndWaitForNextCycle()

    print("=========================================================")
    print("[LEAVE] leaveAndWaitForNextCycle()")
    print("[LEAVE] Account:", player.Name)
    print("=========================================================")

    sendDupeTrue()

    print("[LEAVE] Dupe=true sent")

    task.wait(0.5)

    print("[LEAVE] Setting hasLeft=true")

    hasLeft = true

    print("[LEAVE] hasLeft:", tostring(hasLeft))

    print("[LEAVE] Kicking player...")

    local kickSuccess, kickError = pcall(function()

        player:Kick(
            "Dupe sent - waiting for Check=true AND Busy=false"
        )

    end)

    print("[LEAVE] Kick pcall:", kickSuccess)

    if not kickSuccess then
        warn("[LEAVE] Kick ERROR:", kickError)
    end


    task.spawn(function()

        print("=========================================================")
        print("[WATCHDOG] Started")
        print("[WATCHDOG] Waiting for Check=true AND Busy=false")
        print("=========================================================")

        if ws and ws.OnMessage then

            print("[WATCHDOG] Installing OnMessage listener...")

            local success, err = pcall(function()

                watchdogConnection =
                    ws.OnMessage:Connect(function(msg)

                        print("[WATCHDOG] Message received")

                        local ok, data = pcall(function()
                            return HttpService:JSONDecode(msg)
                        end)

                        if not ok then
                            warn("[WATCHDOG] JSON error:", data)
                            return
                        end

                        if ok and data and
                           data.type == "state" and
                           data.state then

                            local check = data.state.Check
                            local busy = data.state.Busy

                            print(
                                "[WATCHDOG] Check:",
                                tostring(check),
                                "Busy:",
                                tostring(busy)
                            )

                            if check == true and busy == false then

                                print(
                                    "[WATCHDOG] CONDITION MET!"
                                )

                                readyToRejoin = true

                                print(
                                    "[WATCHDOG] readyToRejoin:",
                                    tostring(readyToRejoin)
                                )

                                if watchdogConnection then

                                    print(
                                        "[WATCHDOG] Disconnecting listener..."
                                    )

                                    watchdogConnection:Disconnect()
                                    watchdogConnection = nil

                                end

                            end

                        end

                    end)

            end)

            if success then
                print("[WATCHDOG] Listener installed")
            else
                warn("[WATCHDOG] Listener ERROR:", err)
            end

        else

            warn("[WATCHDOG] WebSocket unavailable")

        end


        while not readyToRejoin do

            print(
                "[WATCHDOG] Waiting... readyToRejoin:",
                tostring(readyToRejoin)
            )

            task.wait(2)

        end


        print("[WATCHDOG] Rejoin condition satisfied")
        print("[WATCHDOG] Waiting 1 second...")

        task.wait(1)

        print("[WATCHDOG] Setting hasLeft=false")

        hasLeft = false

        print("[WATCHDOG] Teleporting to PlaceId:", game.PlaceId)

        local success, err = pcall(function()

            TeleportService:Teleport(
                game.PlaceId,
                player
            )

        end)

        if success then
            print("[WATCHDOG] Teleport request sent")
        else
            warn("[WATCHDOG] Teleport ERROR:", err)
        end

    end)

end


