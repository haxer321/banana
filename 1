local SCRIPT_VERSION = "3.0-MINIMAL"
print(string.format("[DEBUG] Script version: %s", SCRIPT_VERSION))
print("[DEBUG] Script started")

-- ==================== SERVICES ====================
local Players = game:GetService("Players")
local HttpService = game:GetService("HttpService")
local TeleportService = game:GetService("TeleportService")
local GuiService = game:GetService("GuiService")
local player = Players.LocalPlayer

-- ==================== LOAD WEBSOCKET ====================
local websocket = loadstring(game:HttpGet("https://raw.githubusercontent.com/hassanxzayn-lua/WebSocket/main/WebSocket.lua"))()
if not websocket then
    error("WebSocket library failed to load")
end
print("[WS] Library loaded")

local WS_URL = "ws://192.168.1.67:8080"  -- CHANGE TO YOUR SERVER IP
local ws = websocket.connect(WS_URL)
print("[WS] Connected to " .. WS_URL)

-- ==================== MESSAGE HANDLER ====================
ws.OnMessage:Connect(function(msg)
    print("[WS] Received:", msg)
    -- Parse JSON if needed
    local success, data = pcall(function()
        return HttpService:JSONDecode(msg)
    end)
    if success and data then
        print("[WS] Parsed:", data)
        -- Check for state updates
        if data.type == "state" and data.state then
            local check = data.state.Check
            local busy = data.state.Busy
            print(string.format("[WS] Check: %s, Busy: %s", tostring(check), tostring(busy)))
            -- You can add rejoin logic here if needed
        end
    end
end)

-- ==================== SEND DUPE ====================
local function sendDupe()
    local payload = HttpService:JSONEncode({ Dupe = true })
    ws:Send(payload)
    print("[WS] Sent Dupe=true")
end

-- ==================== MAIN LOOP ====================
local counter = 0
while task.wait(1) do
    counter = counter + 1
    ws:Send(HttpService:JSONEncode({ ping = counter }))
    if counter == 10 then
        sendDupe()
    end
    if counter == 20 then
        print("[DEBUG] Closing connection")
        ws:Close()
        break
    end
end

print("[DEBUG] Script ended")
