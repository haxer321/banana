-- WebSocket Configuration
local WS_URL = "ws://192.168.1.14:8080"  -- CHANGE THIS
local ws = nil
local wsConnected = false
local sentFail = false
local sentRecovered = false
local readyToRejoin = false
local watchdogConnection = nil

print(string.format("[DEBUG] WS_URL: %s", WS_URL))

-- ==================== WEBSOCKET SETUP (with pcall) ====================
local function setupWebSocket()
    print("[DEBUG] setupWebSocket called")
    
    -- Check if WebSocket global exists
    if not WebSocket then
        warn("[WS] Global 'WebSocket' is nil – cannot connect!")
        print("[WS] Retrying in 5s...")
        task.wait(5)
        setupWebSocket()
        return
    end

    local success, result = pcall(function()
        return WebSocket.connect(WS_URL)
    end)

    if success and result then
        ws = result
        wsConnected = true
        print("[WS] Connected to server")

        -- Send client_ready (protected)
        local ok, err = pcall(function()
            ws:Send(HttpService:JSONEncode({ type = "client_ready" }))
            print("[WS] Sent client_ready")
        end)
        if not ok then
            warn("[WS] Failed to send client_ready:", err)
        end

        -- Message handler
        ws.OnMessage:Connect(function(msg)
            print(string.format("[WS] Received message (length: %d)", #msg))
            local ok, data = pcall(function()
                return HttpService:JSONDecode(msg)
            end)
            if not ok or not data then
                warn("[WS] Failed to decode message:", ok and "invalid data" or "decode error")
                return
            end

            if data.type == "state" and data.state then
                local state = data.state
                local dupe = state.Dupe
                local check = state.Check
                local busy = state.Busy
                print(string.format("[WS] State - Dupe: %s, Check: %s, Busy: %s",
                    tostring(dupe), tostring(check), tostring(busy)))

                if hasLeft and not readyToRejoin then
                    if check == true and busy == false then
                        print("[WS] Check=true & Busy=false! Ready to rejoin.")
                        readyToRejoin = true
                        if watchdogConnection then
                            watchdogConnection:Disconnect()
                            watchdogConnection = nil
                        end
                    end
                end
            elseif data.type == "event" then
                print(string.format("[WS] Event: %s", data.event))
            else
                print("[WS] Unknown message type:", data.type)
            end
        end)

        ws.OnClose:Connect(function()
            wsConnected = false
            ws = nil
            print("[WS] Disconnected, reconnecting in 5s...")
            task.wait(5)
            setupWebSocket()
        end)

        print("[WS] Connection setup complete")
        return true
    else
        print("[WS] Failed to connect:", tostring(result))
        print("[WS] Retrying in 5s...")
        task.wait(5)
        setupWebSocket()
        return false
    end
end

