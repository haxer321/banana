local function waitForChildWithDebug(parent, name, timeout, stepName)
    timeout = timeout or 30
    print(string.format("[GUI] Waiting for '%s' in '%s' (timeout: %ds) – %s", 
        name, parent.Name, timeout, stepName or ""))
    local child = parent:WaitForChild(name, timeout)
    if child then
        print(string.format("[GUI] Found '%s'", name))
        return child
    else
        error(string.format("Timeout waiting for '%s' in '%s'", name, parent.Name))
    end
end

