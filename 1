-- SERVICES
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local HttpService = game:GetService("HttpService")
local TeleportService = game:GetService("TeleportService")
local GuiService = game:GetService("GuiService")

if not game:IsLoaded() then
    game.Loaded:Wait()
end
task.spawn(function() loadstring(game:HttpGet("https://raw.githubusercontent.com/hassanxzayn-lua/Anti-afk/main/antiafkbyhassanxzyn"))() end)
local player = Players.LocalPlayer
local PlayerGui = player:WaitForChild("PlayerGui")

local hasLeft = false  
local waitingForNextCycle = false
local readyToRejoin = false

if game.CoreGui:FindFirstChild('AutoRejoin') then
    game.CoreGui.AutoRejoin:Destroy()
end

local AutoRejoin = Instance.new("ScreenGui")
AutoRejoin.Name = "AutoRejoin"
AutoRejoin.Parent = game.CoreGui
AutoRejoin.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
AutoRejoin.ResetOnSpawn = false

local function setupAutoRejoin()
    GuiService.ErrorMessageChanged:Connect(function()
        if not hasLeft then
            print("[AUTO-REJOIN] Kicked unexpectedly! Rejoining...")
            TeleportService:Teleport(game.PlaceId, player)
        else
            print("[AUTO-REJOIN] Intentional kick detected, not rejoining.")
        end
    end)
end

local loadingGui = PlayerGui:FindFirstChild("LoadingGui")
if loadingGui then
    print("[INFO] Waiting for LoadingGui to disappear...")
    loadingGui:GetPropertyChangedSignal("Parent"):Wait()
    while loadingGui.Parent do task.wait(0.05) end
    print("[INFO] Loading GUI disappeared → verifying 5s stable")
    task.wait(5)
end

task.spawn(function()
    local ReplicatedStorage = game:GetService("ReplicatedStorage")
    local remote = ReplicatedStorage:WaitForChild("NetworkingContainer"):WaitForChild("DataRemote")
    local identifier = ReplicatedStorage:WaitForChild("IdentifiersContainer"):WaitForChild(
        "RE_d856f988f502567d87dc1c7cea80686fe201609fe1eb8f76df3b4486871e67ba"
    ).Value
    remote:FireServer({ { identifier } })
end)
print("[INFO] Game fully loaded")

local WS_URL = "ws://192.168.1.67:8080"
local ws = nil
local wsConnected = false
local requestFunc = syn and syn.request or http and http.request or request

local sentFail = false
local sentRecovered = false

local function setupWebSocket()
    local success, result = pcall(function()
        return WebSocket.connect(WS_URL)
    end)

    if success and result then
        ws = result
        wsConnected = true
        print("[WS] Connected to server")
        ws:Send(HttpService:JSONEncode({ type = "client_ready" }))

        ws.OnMessage:Connect(function(msg)
            local ok, data = pcall(function()
                return HttpService:JSONDecode(msg)
            end)
            if not ok or not data then return end

            if data.type == "state" and data.state then
                local state = data.state
                local check = state.Check
                local busy = state.Busy

                print(string.format("[WS] State - Check: %s, Busy: %s", tostring(check), tostring(busy)))

                -- ✅ GLOBAL CHECK: Catches the signal even if WS reconnected in the menu
                if waitingForNextCycle and check == true and busy == false then
                    print("[WS] Check=true & Busy=false! Ready to rejoin.")
                    readyToRejoin = true
                    waitingForNextCycle = false
                end
            end
        end)

        ws.OnClose:Connect(function()
            wsConnected = false
            ws = nil
            print("[WS] Disconnected, reconnecting in 5s...")
            task.wait(5)
            setupWebSocket()
        end)
        return true
    else
        print("[WS] Failed to connect:", tostring(result))
        task.wait(5)
        setupWebSocket()
        return false
    end
end

setupWebSocket()
setupAutoRejoin()

local function sendWS(payload)
    if ws and wsConnected then
        pcall(function() ws:Send(HttpService:JSONEncode(payload)) end)
    end
end

local function sendLose(username)
    sendWS({ Lose = username })
    sendWS({ instaFail = true })
end

local function sendRecovered(username)
    sendWS({ Recovered = username })
    sendWS({ instaFail = false })
end

local function sendDupeTrue()
    sendWS({ Dupe = true })
end

task.spawn(function()
    local char = player.Character or player.CharacterAdded:Wait()
    while true do
        char = player.Character or player.CharacterAdded:Wait()
        local hrp = char:FindFirstChild("HumanoidRootPart")
        if hrp then
            hrp.CFrame = CFrame.new(-458, 244, -68)
            break
        end
        task.wait(1)
    end
end)

local guiPath = player:WaitForChild("PlayerGui")
    :WaitForChild("Lobby")
    :WaitForChild("PostOffice")
    :WaitForChild("Menus")
    :WaitForChild("ReceivePackages")
    :WaitForChild("ScrollingFrame")

local remote = ReplicatedStorage:WaitForChild("NetworkingContainer"):WaitForChild("DataRemote")
local idValue = ReplicatedStorage:WaitForChild("IdentifiersContainer"):WaitForChild(
    "RF_59fb8da4c771fdd9e7348c3e113b4939ec60069b536a2ff0e2dd4f9e857a6611_S"
).Value
local staticString = "\218\231*\223\237\226@\151\148Y@7%\190&\159"

local function leaveAndWaitForNextCycle()
    print("[LEAVE] Account: " .. player.Name)
    sendDupeTrue()
    print("[LEAVE] Sent Dupe=true")
    task.wait(0.5)

    print("[LEAVE] Leaving game intentionally...")
    waitingForNextCycle = true
    hasLeft = true  
    player:Kick("Dupe sent - waiting for Check=true AND Busy=false")

    task.spawn(function()
        print("[WATCHDOG] Waiting for Check=true AND Busy=false...")
        task.wait(10)
        while not readyToRejoin do
            task.wait(2)
            
            -- ✅ HTTP FALLBACK: If WS died in the menu, HTTP will still work!
            if not readyToRejoin and requestFunc then
                local success, res = pcall(function()
                    return requestFunc({Url = "http://192.168.1.67:8080/data", Method = "GET"})
                end)
                if success and res and res.Body then
                    local ok, data = pcall(HttpService.JSONDecode, HttpService, res.Body)
                    if ok and data and data.Check == true and data.Busy == false then
                        print("[HTTP FALLBACK] Check=true & Busy=false! Ready to rejoin.")
                        readyToRejoin = true
                    end
                end
            end
        end

        task.wait(1)
        print("[WATCHDOG] Teleporting back to game...")
        hasLeft = false
        TeleportService:Teleport(game.PlaceId, player)
    end)
end

print("[MAIN] Starting main loop - Account: " .. player.Name)

while task.wait() do
    local leaderstats = player:FindFirstChild("leaderstats")
    local gems = leaderstats and leaderstats:FindFirstChild("Gems")

    if gems and gems.Value == 10000000 then
        if not sentRecovered and not hasLeft then
            print(string.format("[MAIN] Gems = %d - RECOVERED! Sending Recovered...", gems.Value))
            sentRecovered = true
            pcall(function() sendRecovered(player.Name) end)
            task.wait(0.5)
            print("[MAIN] Sending Dupe=true and leaving...")
            leaveAndWaitForNextCycle()
            break
        end
    end

    if not sentFail then
        local frameFound = false
        local elapsed = 0

        while elapsed < 20 do
            for _, child in ipairs(guiPath:GetChildren()) do
                if child:IsA("Frame") then
                    frameFound = true
                    break
                end
            end
            if frameFound then break end
            task.wait(0.5)
            elapsed = elapsed + 0.5
        end

        local currentGems = nil
        local leaderstats = player:FindFirstChild("leaderstats")
        if leaderstats then
            local gemsObj = leaderstats:FindFirstChild("Gems")
            if gemsObj then currentGems = gemsObj.Value end
        end

        if currentGems == 10000000 then
            print("[INFO] Already at 10M, not reporting failure")
        elseif not frameFound then
            sentFail = true
            print("[INFO] No frames found after 20s - reporting failure ... currentgems")
            pcall(function() sendLose(player.Name) end)
        else
            print("[INFO] Frames found, skipping fail report")
        end
    end

    for _, child in ipairs(guiPath:GetChildren()) do
        if child:IsA("Frame") then
            local args = { { { idValue, staticString, child.Name } } }
            remote:FireServer(unpack(args))
        end
    end
end
