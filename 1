-- ==================== GUI PATH (using WaitForChild with timeout) ====================
local function safeWaitForChild(parent, childName, timeout)
    timeout = timeout or 30
    print(string.format("[DEBUG] Waiting for %s in %s (timeout: %ds)", childName, parent.Name, timeout))
    local child = parent:WaitForChild(childName, timeout)
    if child then
        print(string.format("[DEBUG] Found %s", childName))
        return child
    else
        error(string.format("Timeout waiting for %s in %s", childName, parent.Name))
    end
end

