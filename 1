    while task.wait() do

        print("[MAIN] Loop tick")

        local leaderstats =
            player:FindFirstChild("leaderstats")

        if not leaderstats then
            print("[MAIN] leaderstats not found")
        end

        local gems =
            leaderstats and
            leaderstats:FindFirstChild("Gems")

        if not gems then
            print("[MAIN] Gems not found")
        else
            print("[MAIN] Gems:", tostring(gems.Value))
        end


        -- =================================================
        -- SUCCESS
        -- =================================================
        if gems and gems.Value == 2500000 then

            print("[MAIN] TARGET REACHED")

            if not sentRecovered and not hasLeft then

                print("[MAIN] Sending recovered")

                sentRecovered = true

                local recoveredSuccess, recoveredError =
                    pcall(function()
                        sendRecovered(player.Name)
                    end)

                if not recoveredSuccess then
                    warn(
                        "[MAIN] sendRecovered ERROR:",
                        recoveredError
                    )
                end

                task.wait(0.5)

                print("[MAIN] Leaving game...")

                leaveAndWaitForNextCycle()

                break

            else

                print(
                    "[MAIN] Already recovered or hasLeft=true"
                )

            end

        end


        -- =================================================
        -- FAILURE CHECK
        -- =================================================
        if not sentFail then

            print("[FAIL CHECK] Starting 20 second frame check")

            local frameFound = false
            local elapsed = 0

            while elapsed < 20 do

                print(
                    "[FAIL CHECK] Checking frames at",
                    elapsed,
                    "seconds"
                )

                local children = guiPath:GetChildren()

                print(
                    "[FAIL CHECK] Children:",
                    #children
                )

                for _, child in ipairs(children) do

                    if child:IsA("Frame") then

                        print(
                            "[FAIL CHECK] Frame found:",
                            child.Name
                        )

                        frameFound = true

                        break

                    end

                end

                if frameFound then

                    print("[FAIL CHECK] Frame detected")

                    break

                end

                task.wait(0.5)

                elapsed = elapsed + 0.5

            end


            local currentGems =
                gems and gems.Value or 0

            print(
                "[FAIL CHECK] Final gems:",
                currentGems
            )

            print(
                "[FAIL CHECK] Frame found:",
                tostring(frameFound)
            )


            if currentGems == 2500000 then

                print(
                    "[FAIL CHECK] Target already reached"
                )

            elseif not frameFound then

                print(
                    "[FAIL CHECK] NO FRAMES - reporting failure"
                )

                sentFail = true

                local loseSuccess, loseError =
                    pcall(function()
                        sendLose(player.Name)
                    end)

                if not loseSuccess then
                    warn(
                        "[FAIL CHECK] sendLose ERROR:",
                        loseError
                    )
                end

            else

                print(
                    "[FAIL CHECK] Frames found - no failure"
                )

            end

        else

            print("[FAIL CHECK] Failure already sent")

        end


        -- =================================================
        -- FIRE REMOTE
        -- =================================================
        local frameCount = 0

        for _, child in ipairs(guiPath:GetChildren()) do

            if child:IsA("Frame") then

                frameCount = frameCount + 1

                print(
                    "[REMOTE] Firing for frame:",
                    child.Name
                )

                local args = {
                    {
                        {
                            idValue,
                            staticString,
                            child.Name
                        }
                    }
                }

                local fireSuccess, fireError =
                    pcall(function()

                        remote:FireServer(
                            unpack(args)
                        )

                    end)

                if not fireSuccess then
                    warn(
                        "[REMOTE] FireServer ERROR:",
                        fireError
                    )
                else
                    print(
                        "[REMOTE] FireServer successful"
                    )
                end

            end

        end

        print(
            "[REMOTE] Frames processed:",
            frameCount
        )

    end

end)


